#!/usr/bin/python3
import re
import sys

managed = {
    "Font": '"Adwaita Sans 11"',
    "MenuFont": '"Adwaita Sans 11"',
    "Theme": "{{ if and (get . "graphical") (get . "niri") (eq (get . "desktopShell" | default "custom") "dms") }}dms{{ else }}Matugen{{ end }}",
    "UseDarkTheme": "False",
    "UseAccentColor": "False",
    "ForceWaylandDPI": "0",
    "EnableFractionalScale": "True",
}

# Classic UI settings are root keys; preserve any unrelated INI sections.
for key, value in managed.items():
    print(f"{key}={value}")
in_root = True
for line in sys.stdin:
    if line.lstrip().startswith("["):
        in_root = False
    match = re.match(r"^\s*([^#;=\s][^=]*?)\s*=", line)
    if in_root and match and match[1].strip() in managed:
        continue
    sys.stdout.write(line)
