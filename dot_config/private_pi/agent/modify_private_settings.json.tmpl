#!/usr/bin/env python3
import json
import sys

raw = sys.stdin.read()
settings = json.loads(raw) if raw.strip() else {}

settings.update(
    {
        "defaultProvider": "openai",
        "defaultModel": "gpt-6.1-sol",
        "defaultThinkingLevel": "high",
        "defaultTools": ["+codemode"],
        "codemode": {**settings.get("codemode", {}), "mode": "on"},
        "hideThinkingBlock": True,
        "enabledModels": [
            "anthropic/claude-opus-5-5",
            "openai/gpt-5.6-sol",
            "openai/gpt-6-astra",
            "openai/gpt-6-luna",
            "openai/gpt-6.1-sol",
            "openai/gpt-6.1-terra",
            "deepseek/deepseek-flash",
            "google/gemini-4-argon",
        ],
        "npmCommand": ["pnpm", "--config.node-linker=hoisted"],
        "packages": [
            "npm:@juicesharp/rpiv-ask-user-question@2.15.0",
            "npm:@oai404iao/pi-notify@0.1.0",
            "npm:@oai404iao/pi-codex-minimal-tools@5.1.3",
            "npm:@oai404iao/pi-subagent@1.3.1",
        ],
        "theme": "dark",
        "sessionDir": "~/.local/state/pi/agent/sessions",
    }
)

json.dump(settings, sys.stdout, ensure_ascii=False, indent=2)
