#!/usr/bin/env python3
import json
import sys

raw = sys.stdin.read()
settings = json.loads(raw) if raw.strip() else {}

settings.update(
    {
        "defaultProvider": "openai",
        "defaultModel": "gpt-6-astra",
        "defaultThinkingLevel": "high",
        "defaultTools": ["+codemode"],
        "codemode": {**settings.get("codemode", {}), "mode": "on"},
        "hideThinkingBlock": True,
        "enabledModels": [
            "anthropic/claude-opus-5-5",
            "openai/gpt-5.6-sol",
            "openai/gpt-6-astra",
            "openai/gpt-6-luna",
            "openai/gpt-6.1-sol",
            "deepseek/deepseek-flash",
        ],
        "npmCommand": ["pnpm", "--config.node-linker=hoisted"],
        "packages": [
            "npm:@juicesharp/rpiv-ask-user-question@2.12.0",
{{- if .graphical }}
            {{ joinPath .chezmoi.homeDir ".local/share/pi/extensions/pi-local-notify" | toJson }},
{{- else }}
            "npm:@oai404iao/pi-telegram-notify@0.6.0",
{{- end }}
            "npm:@oai404iao/pi-codex-minimal-tools@4.1.1",
            "npm:@oai404iao/pi-subagent@1.0.1",
        ],
        "theme": "dark",
        "sessionDir": "~/.local/state/pi/agent/sessions",
    }
)

json.dump(settings, sys.stdout, ensure_ascii=False, indent=2)
