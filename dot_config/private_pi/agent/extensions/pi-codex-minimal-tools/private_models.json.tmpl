{
  "$schema": "https://unpkg.com/@oai404iao/pi-codex-minimal-tools@3.0.0/models.schema.json",
  "version": 1,
  "models": [
    {
      "id": "openai/gpt-5.6-sol",
      "enabled": true,
      "responses": {
        "providerShim": true,
        "endpoint": "openai",
        "mode": "lite",
        "systemPromptPlacement": "developer",
        "transport": "auto",
        "websocketPrewarm": true,
        "reasoningSummary": "auto"
      },
      "tools": {
        "parallelCalls": false,
        "applyPatch": "custom",
        "webSearch": {
          "implementation": "standalone",
          "contentTypes": [
            "text",
            "image"
          ]
        },
        "imageGeneration": "standalone",
        "viewImage": false
      },
      "compaction": "responses",
      "fast": {
        "serviceTier": "priority",
        "costMultiplier": 2
      }
    },
    {
      "id": "openai/gpt-6-astra",
      "extends": "openai/gpt-5.6-sol",
      "responses": {
        "reasoningSummary": "auto"
      }
    }
  ]
}
