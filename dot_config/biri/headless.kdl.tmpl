{{- $reuseDMS := and .graphical .niri (eq (get . "desktopShell" | default "custom") "dms") -}}
{{ if $reuseDMS -}}
include "../niri/profile.kdl"

{{ end -}}
// Sunshine inherits this compositor's Wayland socket.
spawn-at-startup {{ template "biri-sunshine-args" "HEADLESS-1" }} "origin_web_ui_allowed=pc"
{{ if not $reuseDMS -}}

binds {
    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+O { toggle-overview; }
    Mod+F { maximize-column; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
}
{{- end }}
