// Sunshine inherits this compositor's Wayland socket and captures its only output.
spawn-at-startup "/usr/bin/sunshine" "capture=wlr" "output_name=HEADLESS-1" "upnp=off" "origin_web_ui_allowed=pc"

binds {
    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+O { toggle-overview; }
    Mod+F { maximize-column; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
}
