{{- if eq (get . "biri") "desktop" -}}
{{- $output := "SUNSHINE-1" -}}
// Keep the virtual output ahead of DMS's generated output preferences.
output {{ $output | quote }} {
    create-virtual
    mode "1920x1080@60.000"
    focus-at-startup
}

// Stop the capture process when niri.service ends, even if the user manager stays up.
spawn-at-startup "/usr/bin/systemd-run" "--user" "--scope" "--collect" "--unit=biri-desktop-sunshine.scope" "--property=BindsTo=niri.service" "--property=After=niri.service" {{ template "biri-sunshine-args" $output }}

{{ end -}}
include "profile.kdl"
