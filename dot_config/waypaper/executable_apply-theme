#!/usr/bin/env python3
"""Apply a Matugen theme to the wallpaper currently shown by awww."""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def notify_error(message: str) -> None:
    print(message, file=sys.stderr)
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "-u", "critical", "Wallpaper theme", message],
            check=False,
        )


def current_wallpaper() -> Path:
    result = subprocess.run(
        ["awww", "query", "--json"],
        check=True,
        capture_output=True,
        text=True,
    )
    namespaces = json.loads(result.stdout)
    if not isinstance(namespaces, dict):
        raise RuntimeError("unexpected response from awww query")

    for outputs in namespaces.values():
        for output in outputs:
            displaying = output.get("displaying", {})
            image = displaying.get("image")
            if image:
                path = Path(image)
                if path.is_file():
                    return path

    raise RuntimeError("awww did not report a readable wallpaper")


def main() -> int:
    state_dir = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
    ) / "waypaper"
    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)

    with (state_dir / "theme.lock").open("w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        wallpaper = current_wallpaper()
        subprocess.run(["matugen", "image", str(wallpaper)], check=True)

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        notify_error(str(error))
        raise SystemExit(1) from error
