{{- if .niri -}}
#!/bin/sh
set -eu

# Niri owns swayidle through spawn-at-startup. Leave the current process
# running, but prevent the user unit from starting a duplicate next session.
wants_link="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/niri.service.wants/swayidle.service"

if [ -L "$wants_link" ]; then
    rm -- "$wants_link"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user daemon-reload
    fi
elif command -v systemctl >/dev/null 2>&1 &&
    systemctl --user is-enabled --quiet swayidle.service
then
    systemctl --user disable swayidle.service
fi
{{- end }}
