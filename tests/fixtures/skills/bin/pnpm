#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys

with Path(os.environ["SKILLS_TEST_LOG"]).open("a") as log:
    log.write(json.dumps({
        "args": sys.argv[1:],
        "home": os.environ["HOME"],
        "tmpdir": os.environ["TMPDIR"],
        "telemetry": os.environ.get("DISABLE_TELEMETRY"),
    }) + "\n")
sys.exit(int(os.environ.get("SKILLS_TEST_EXIT", "0")))
