{{- $sshAgent := false -}}
{{- if hasKey . "sshAgent" -}}
{{-   $sshAgent = .sshAgent -}}
{{- end -}}
{{- $sshInboundIdentity := "none" -}}
{{- if hasKey . "sshInboundIdentity" -}}
{{-   $sshInboundIdentity = .sshInboundIdentity -}}
{{- end -}}
{{- $safeRm := false -}}
{{- $desktopShell := get . "desktopShell" | default "custom" -}}
{{- if not (has $desktopShell (list "custom" "dms")) -}}
{{-   fail "desktopShell must be custom or dms" -}}
{{- end -}}
{{- if hasKey . "safeRm" -}}
{{-   $safeRm = .safeRm -}}
{{- end -}}
