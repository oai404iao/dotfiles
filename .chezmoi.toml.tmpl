{{- $roles := list "desktop" "laptop" "server" -}}
{{- $role := promptChoiceOnce . "role" "Machine role" $roles "desktop" -}}
{{- $graphical := promptBoolOnce . "graphical" "Graphical machine" true -}}
{{- $niri := false -}}
{{- if $graphical -}}
{{-   $niri = promptBoolOnce . "niri" "Use niri" true -}}
{{- end -}}
{{- $work := promptBoolOnce . "work" "Work machine" false -}}

encryption = "age"
mode = "file"

[age]
    identity = "~/.config/chezmoi/age-identity.txt"
    recipient = "age19pgcjnn8ssmrv6q2uf23mc93qewn4qpw328765vcgvwewapvgqhswvf20c"

[add]
    secrets = "error"

[git]
    autoAdd = false
    autoCommit = false
    autoPush = false

[template]
    options = ["missingkey=error"]

[rbw]
    command = "rbw"

[data]
    role = {{ $role | quote }}
    graphical = {{ $graphical }}
    niri = {{ $niri }}
    work = {{ $work }}
    secretBackend = "rbw"
