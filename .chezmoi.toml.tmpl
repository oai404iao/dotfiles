{{- $roles := list "desktop" "laptop" "server" -}}
{{- $role := promptChoiceOnce . "role" "Machine role" $roles "desktop" -}}
{{- $shells := list "zsh" "bash" -}}
{{- $shell := promptChoiceOnce . "shell" "Default shell" $shells "zsh" -}}
{{- $graphical := promptBoolOnce . "graphical" "Graphical machine" true -}}
{{- $niri := false -}}
{{- $desktopShell := "custom" -}}
{{- $niriOutputProfile := "auto" -}}
{{- if $graphical -}}
{{-   $niri = promptBoolOnce . "niri" "Use niri" true -}}
{{-   if $niri -}}
{{-     $desktopShell = promptChoiceOnce . "desktopShell" "Desktop shell: DMS or custom components" (list "dms" "custom") "custom" -}}
{{-     $outputProfiles := list "auto" "laptop-dual-1080p" "desktop-single-4k" -}}
{{-     $niriOutputProfile = promptChoiceOnce . "niriOutputProfile" "Niri output profile" $outputProfiles "auto" -}}
{{-   end -}}
{{- end -}}
{{- $work := promptBoolOnce . "work" "Work machine" false -}}
{{- $sshAgent := promptBoolOnce . "sshAgent" "Use rbw SSH agent" (ne $role "server") -}}
{{- $sshInboundIdentities := list "none" "private" "uni" -}}
{{- $sshInboundIdentity := promptChoiceOnce . "sshInboundIdentity" "SSH authorized_keys identity" $sshInboundIdentities "none" -}}
{{- $safeRm := promptBoolOnce . "safeRm" "Use recoverable rm wrapper" false -}}

encryption = "age"
mode = "file"

[age]
    identity = "~/.config/chezmoi/age-identity.txt"
    recipient = "age19pgcjnn8ssmrv6q2uf23mc93qewn4qpw328765vcgvwewapvgqhswvf20c"

[add]
    secrets = "error"

[git]
    autoAdd = false
    autoCommit = false
    autoPush = false

[template]
    options = ["missingkey=error"]

[rbw]
    command = "rbw"

[data]
    role = {{ $role | quote }}
    shell = {{ $shell | quote }}
    graphical = {{ $graphical }}
    niri = {{ $niri }}
    desktopShell = {{ $desktopShell | quote }}
    niriOutputProfile = {{ $niriOutputProfile | quote }}
    work = {{ $work }}
    sshAgent = {{ $sshAgent }}
    sshInboundIdentity = {{ $sshInboundIdentity | quote }}
    safeRm = {{ $safeRm }}
    secretBackend = "rbw"
